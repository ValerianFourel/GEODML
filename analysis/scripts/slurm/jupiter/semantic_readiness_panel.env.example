# Copy to a private shell file outside Git, replace every placeholder, then source it.
# The three production judges must be pinned snapshots from distinct model families.

export JUPITER_ACCOUNT="scifi"
export JUPITER_PROJECT="scifi"
export GEODML_EXPECTED_COMMIT="<phase2-production-commit-sha>"

export GEODML_PROJECT_ROOT="$PROJECT/$USER/geodml"
export GEODML_CACHE_ROOT="$FSCRATCH/$USER/geodml"
export GEODML_AI_VENV="$GEODML_CACHE_ROOT/python/.venv-ai-pytorch291"

export READINESS_RUN="$GEODML_PROJECT_ROOT/runs/semantic-readiness-phase2/$GEODML_EXPECTED_COMMIT"
export READINESS_JUDGE_TASKS="$GEODML_PROJECT_ROOT/runs/semantic-readiness-base-axis/f6d9e6df42c90b425e4035bb9f28cb551be63175/label-tasks/readiness_label_tasks_blinded.jsonl"
export READINESS_JUDGE_TASKS_SHA256="9c1e084332d4fc3129a1f1c5400b8118d7a3425a01f3c771edb133d66d496775"
export READINESS_EXPECTED_TASKS_PER_SLOT="5091"
export READINESS_CODEBOOK="$GEODML_PROJECT_ROOT/runs/semantic-readiness-base-axis/f6d9e6df42c90b425e4035bb9f28cb551be63175/label-tasks/readiness_label_codebook_private.jsonl"

export PRIMARY_JUDGE_FAMILY="<primary-family>"
export PRIMARY_JUDGE_MODEL="$GEODML_PROJECT_ROOT/models/$PRIMARY_JUDGE_FAMILY/<primary-revision>"
export PRIMARY_JUDGE_REVISION="<primary-revision>"

export REPLICATE_A_JUDGE_FAMILY="<replicate-a-family>"
export REPLICATE_A_JUDGE_MODEL="$GEODML_PROJECT_ROOT/models/$REPLICATE_A_JUDGE_FAMILY/<replicate-a-revision>"
export REPLICATE_A_JUDGE_REVISION="<replicate-a-revision>"

export REPLICATE_B_JUDGE_FAMILY="<replicate-b-family>"
export REPLICATE_B_JUDGE_MODEL="$GEODML_PROJECT_ROOT/models/$REPLICATE_B_JUDGE_FAMILY/<replicate-b-revision>"
